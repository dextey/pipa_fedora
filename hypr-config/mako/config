# Mako — Nord, with a real timeout so notifications auto-dismiss.
# This is the fix for "notification pops up but never goes away":
# the default-timeout was unset, so popups stayed forever.

# ---- behaviour ----
default-timeout=5000      # 5 seconds, in ms  <-- the key fix
ignore-timeout=0
max-visible=4
layer=overlay

# ---- sizing (smaller, top-right) ----
width=300
height=110
margin=10
padding=10
border-size=1
border-radius=10
font=JetBrainsMono Nerd Font 11
icons=1
max-icon-size=36
anchor=top-right

# ---- Nord colours ----
background-color=#2e3440
text-color=#eceff4
border-color=#88c0d0
progress-color=over #3b4252

[urgency=low]
border-color=#81a1c1
default-timeout=4000

[urgency=normal]
border-color=#88c0d0

[urgency=critical]
border-color=#bf616a
default-timeout=0         # critical stays until dismissed (intentional)
