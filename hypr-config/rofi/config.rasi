/* Rofi — Nord, touch-sized for Xiaomi Pad 6 */
/* Save as ~/.config/rofi/config.rasi  */

configuration {
    modi: "drun,run,window";
    show-icons: true;
    drun-display-format: "{name}";
    display-drun: " Apps";
    display-run:  " Run";
    display-window: " Windows";
}

* {
    bg:       #2e3440;
    bg-alt:   #3b4252;
    fg:       #eceff4;
    fg-alt:   #d8dee9;
    mauve:    #88c0d0;
    blue:     #81a1c1;
    surface1: #434c5e;

    background-color: transparent;
    text-color: @fg;
    font: "JetBrainsMono Nerd Font 16";
}

window {
    background-color: @bg;
    border: 2px;
    border-color: @mauve;
    border-radius: 14px;
    width: 60%;
    padding: 16px;
}

mainbox { children: [ inputbar, listview ]; spacing: 14px; }

inputbar {
    background-color: @bg-alt;
    border-radius: 10px;
    padding: 14px 18px;
    children: [ prompt, entry ];
    spacing: 10px;
}

prompt { text-color: @mauve; }
entry  { placeholder: "Search…"; placeholder-color: @fg-alt; }

listview {
    lines: 8;
    columns: 1;
    spacing: 6px;
    scrollbar: false;
}

/* tall rows = easy finger taps */
element {
    padding: 14px;
    border-radius: 10px;
    spacing: 12px;
}
element selected {
    background-color: @mauve;
    text-color: @bg;
}
element-icon { size: 28px; vertical-align: 0.5; }
element-text { vertical-align: 0.5; }
